# Environment Configuration for University ERP & LMS

# App
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_UNIVERSITY_NAME="Jagran Lakecity University"

# Database Connection (SQLite default for zero-setup local dev; or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/university_erp?schema=public"

# Authentication Secrets
JWT_SECRET="super-secret-enterprise-key-change-in-production-min-32-chars-long"
SESSION_EXPIRY="7d"

# Payment Sandbox Keys (Never put live credentials here)
NEXT_PUBLIC_PAYMENT_GATEWAY="SANDBOX"
PAYMENT_SANDBOX_MERCHANT_ID="MERCHANT_UNIV_TEST_001"
PAYMENT_SANDBOX_KEY="sandbox_secret_key_univ_test_998877"

# Storage
UPLOAD_DIR="./public/uploads"

# Node Environment
NODE_ENV="development"
