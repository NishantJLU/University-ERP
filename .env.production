# Production Environment Defaults for Deployment
PORT=3000
NEXT_PUBLIC_APP_URL="https://university-erp.vercel.app"
NEXT_PUBLIC_UNIVERSITY_NAME="Jagran Lakecity University"

# Database Connection (automatically resolved to /tmp/dev.db in Vercel serverless functions)
DATABASE_URL="file:./dev.db"

# Authentication Secrets
JWT_SECRET="super-secret-enterprise-key-change-in-production-min-32-chars-long"
SESSION_EXPIRY="7d"

# Payment Sandbox Keys
NEXT_PUBLIC_PAYMENT_GATEWAY="SANDBOX"
PAYMENT_SANDBOX_MERCHANT_ID="MERCHANT_UNIV_TEST_001"
PAYMENT_SANDBOX_KEY="sandbox_secret_key_univ_test_998877"

# Storage
UPLOAD_DIR="./public/uploads"

# Demo Mode Enabled for Evaluation
DEMO_MODE="true"

# Node Environment
NODE_ENV="production"
